# Copy this file to .env.local and fill in real values.
# .env.local is NEVER committed to GitHub.

# MongoDB Atlas connection string (include the database name /foodrescue)
# Example shape: mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/foodrescue?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://rifat9461_db_user:foodrescue@cluster0.jqntak.mongodb.net/foodrescue?appName=Cluster0

# Long random string used to sign login tokens (at least 32 characters)
# Generate one: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=

# Only used by `npm run create-admin` (creates the first admin account)
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Optional: public site URL (used for SEO/social metadata), e.g. https://foodrescue.vercel.app
NEXT_PUBLIC_SITE_URL=

# Optional: set to "off" to hide the one-click demo accounts on the login page (do this in production)
NEXT_PUBLIC_DEMO_LOGINS=on
